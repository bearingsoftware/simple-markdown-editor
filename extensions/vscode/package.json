{
  "name": "simple-markdown-editor",
  "displayName": "Simple Markdown Editor",
  "description": "Open Markdown files in Simple Markdown Editor, the native Windows Markdown editor.",
  "version": "0.1.1",
  "publisher": "bearingsoftware",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bearingsoftware/simple-markdown-editor.git",
    "directory": "extensions/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "mdedit.openExternal",
        "title": "Open in Simple Markdown Editor"
      },
      {
        "command": "mdedit.openRecent",
        "title": "Open Recent from Simple Markdown Editor"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mdedit.openExternal",
          "when": "isWindows && resourceFilename =~ /\\.(md|markdown)$/i",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "mdedit.openExternal",
          "when": "isWindows && resourceFilename =~ /\\.(md|markdown)$/i",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "mdedit.openExternal",
          "when": "isWindows && resourceFilename =~ /\\.(md|markdown)$/i",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mdedit.openExternal",
          "when": "isWindows && resourceFilename =~ /\\.(md|markdown)$/i"
        },
        {
          "command": "mdedit.openRecent",
          "when": "isWindows"
        }
      ]
    },
    "configuration": {
      "title": "Simple Markdown Editor",
      "properties": {
        "mdedit.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Full path to `mdedit.exe`. Leave empty to use the installed editor. Machine-scoped, so a workspace cannot set it."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "check": "tsc --noEmit",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.1.0",
    "typescript": "5.9.3"
  }
}
